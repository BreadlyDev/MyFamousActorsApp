<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ActorDescriptionActivity"
    android:background="@drawable/famous_actors_background">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/image_view"
            android:layout_width="225dp"
            android:layout_height="225dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.496"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.085"
            android:layout_marginTop="40dp"
            android:src="@drawable/male_avatar"/>

        <View
            android:layout_width="300dp"
            android:layout_height="2dp"
            android:background="#4E4E4E"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@+id/actor_name"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/actor_name"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/image_view"
            android:layout_marginTop="20dp"
            android:layout_marginHorizontal="40dp"
            android:text="Michael Jordan"
            android:textAlignment="center"
            android:textColor="@color/black"
            android:textSize="32dp"
            android:fontFamily="@font/merriweathersans_medium"
            app:layout_constraintVertical_weight="1"
            />

        <TextView
            android:id="@+id/actor_age"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/actor_name"
            android:layout_marginHorizontal="40dp"
            android:text="Age: 61"
            android:textAlignment="center"
            android:textColor="@color/black"
            android:textSize="24dp"
            android:fontFamily="@font/merriweathersans_medium"
            />

        <TextView
            android:id="@+id/actor_gender"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/actor_age"
            android:layout_marginHorizontal="40dp"
            android:text="Gender: Male"
            android:textAlignment="center"
            android:textColor="@color/black"
            android:textSize="24dp"
            android:fontFamily="@font/merriweathersans_medium"
            />

        <TextView
            android:id="@+id/actor_birthday"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/actor_gender"
            android:layout_marginHorizontal="40dp"
            android:text="Birthday: 17.02.1963"
            android:textAlignment="center"
            android:textColor="@color/black"
            android:textSize="24dp"
            android:fontFamily="@font/merriweathersans_medium"
            />

        <TextView
            android:id="@+id/actor_height"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/actor_birthday"
            android:layout_marginHorizontal="40dp"
            android:text="Height: 1.98 m"
            android:textAlignment="center"
            android:textColor="@color/black"
            android:textSize="24dp"
            android:fontFamily="@font/merriweathersans_medium"
            />

        <TextView
            android:id="@+id/actor_nationality"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/actor_height"
            android:layout_marginHorizontal="40dp"
            android:text="Nationality: US"
            android:textAlignment="center"
            android:textColor="@color/black"
            android:textSize="24dp"
            android:fontFamily="@font/merriweathersans_medium"
            />

        <TextView
            android:id="@+id/actor_is_alive"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/actor_nationality"
            android:layout_marginHorizontal="40dp"
            android:text="Is alive: yes"
            android:textAlignment="center"
            android:textColor="@color/black"
            android:textSize="24dp"
            android:fontFamily="@font/merriweathersans_medium"
            />

        <TextView
            android:id="@+id/actor_occupation"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/actor_is_alive"
            android:layout_marginHorizontal="40dp"
            android:text="Occupation:\n basketball_player"
            android:textAlignment="center"
            android:textColor="@color/black"
            android:textSize="24dp"
            android:fontFamily="@font/merriweathersans_medium"
            app:layout_constraintVertical_weight="1"
            />

        <Button
            android:id="@+id/go_back_btn"
            android:layout_width="180dp"
            android:layout_height="60dp"
            android:backgroundTint="#FDA610"
            android:text="Go Back"
            android:textColor="@color/black"
            android:textSize="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/actor_occupation"
            app:layout_constraintVertical_bias="0.068" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>